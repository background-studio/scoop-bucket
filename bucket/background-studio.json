{
  "version": "0.1.3",
  "description": "Background Studio host: one tray to manage Codex, Notion, and Multica background plugins.",
  "homepage": "https://github.com/background-studio/background-studio",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/background-studio/background-studio/releases/download/v0.1.3/Background.Studio_0.1.3_x64-setup.exe#/dl.7z",
      "hash": "f9dfc74278e4c6a91a9e104b2b35da013ca8f0299e2551ec09ee58b74a4eb01c"
    }
  },
  "bin": "background-studio.exe",
  "shortcuts": [
    [
      "background-studio.exe",
      "Background Studio"
    ]
  ],
  "post_install": [
    "Remove-Item \"$dir\\`$PLUGINSDIR\" -Recurse -Force -ErrorAction SilentlyContinue"
  ],
  "checkver": {
    "github": "https://github.com/background-studio/background-studio"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/background-studio/background-studio/releases/download/v$version/Background.Studio_$version_x64-setup.exe#/dl.7z",
        "hash": {
          "url": "https://api.github.com/repos/background-studio/background-studio/releases/tags/v$version",
          "jsonpath": "$.assets[?(@.name == 'Background.Studio_$version_x64-setup.exe')].digest",
          "regex": "sha256:([a-fA-F0-9]{64})"
        }
      }
    }
  },
  "notes": [
    "Executable inside the NSIS package is background-studio.exe (cargo name), not 'Background Studio.exe'.",
    "Data lives in %LOCALAPPDATA%\\BackgroundStudio (or the directory set in host.json).",
    "If you previously installed the NSIS setup, quit/uninstall it first to avoid double tray icons; settings are kept."
  ]
}
